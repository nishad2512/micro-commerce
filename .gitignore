# ==========================================
# Dependencies and Package Managers
# ==========================================
node_modules/
jspm_packages/
web_modules/
.npm
.eslintcache
.stylelintcache
.prettiercache
package-lock.json
yarn.lock
pnpm-lock.yaml
bun.lockb

# ==========================================
# TypeScript and Build Outputs
# ==========================================
dist/
build/
out/
tsconfig.tsbuildinfo

# ==========================================
# gRPC / Protocol Buffers (Generated Code)
# ==========================================
# Ignore auto-generated JS/TS files from .proto definitions 
# (Keep your actual .proto source files tracked!)
*_pb.js
*_pb.d.ts
*_grpc_pb.js
*_grpc_pb.d.ts
src/generated/

# ==========================================
# Prisma ORM
# ==========================================
# Ignore SQLite dev databases if used locally
*.db
*.db-journal

# ==========================================
# Environment Variables and Secrets
# ==========================================
# Contains MongoDB credentials, RabbitMQ URLs, and ports
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# ==========================================
# Logs and Debugging
# ==========================================
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pids
*.pid
*.seed
*.pid.lock

# ==========================================
# Testing and Coverage
# ==========================================
coverage/
.nyc_output
.jest/
*.lcov

# ==========================================
# Docker (If using containers for Mongo/Rabbit)
# ==========================================
.docker/
# Ignore local persistent data volumes so they don't sync to Git
.docker-data/
mongodb-data/
rabbitmq-data/

# ==========================================
# IDE and System Files
# ==========================================
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db
