NODE_ENV=development
FRONTEND_URL=http://localhost:5173
JWT_ACCESS_SECRET=replace-with-a-32-character-minimum-development-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-character-minimum-secret
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
RABBITMQ_URL=amqp://rabbitmq:5672
MONGO_URI=mongodb://mongo:27017/saga_user?replicaSet=rs0
DATABASE_URL=postgresql://postgres:replace-me@postgres:5432/saga_order
PRODUCT_GRPC_URL=product-service:50053
